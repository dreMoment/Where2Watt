# MongoDB container and application connection
MONGO_USERNAME=where2watt
MONGO_PASSWORD=where2watt-local
MONGODB_URI=mongodb://where2watt:where2watt-local@mongodb:27017/?authSource=admin
MONGODB_DB_NAME=where2watt_dev

# Local-only signing secrets. Use unique secrets outside local development.
JWT_SECRET=local-development-jwt-secret-change-before-sharing
ACTOR_ID_SECRET=local-development-actor-id-secret-change-before-sharing

# A numeric Strava athlete ID is required at startup. Replace this with your ID
# to use admin features.
ADMIN_STRAVA_IDS=1
CORS_ORIGIN=http://localhost:3000

# Optional until exercising Strava authentication/imports.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SECRET=
ADMIN_DISCORD_WEBHOOK_URL=

